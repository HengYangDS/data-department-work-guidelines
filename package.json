    "test": "node tools/docs/cli.mjs test"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.14.0",
    "entities": "8.1.0",
    "htmlparser2": "12.0.0",
    "markdownlint": "0.41.1",
    "markdownlint-cli2": "0.23.3",
    "micromark": "4.0.3",
    "prettier": "3.9.9",
    "semver": "7.8.5",
    "shell-quote": "1.11.0",
    "smol-toml": "1.9.0",
    "yaml": "2.9.1"
  },
  "license": "MIT",
  "engines": {
    "node": "26.x"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.2.0",
      "onFail": "error"
    }
  },
  "overrides": {
    "micromark": "$micromark"
  }
