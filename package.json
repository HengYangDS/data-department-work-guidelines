{
  "name": "data-department-work-guidelines",
  "private": true,
  "description": "Documentation quality tooling for the data department work guidelines.",
  "scripts": {
    "verify": "node tools/docs/cli.mjs verify",
    "format": "node tools/docs/cli.mjs format",
    "prose": "node tools/docs/cli.mjs prose",
    "test": "node tools/docs/cli.mjs test"
  },
  "devDependencies": {
    "@dprint/formatter": "0.5.1",
    "@dprint/toml": "0.9.0",
    "@fission-ai/openspec": "1.14.0",
    "entities": "8.1.0",
    "htmlparser2": "12.0.0",
    "markdownlint": "0.41.1",
    "micromark": "4.0.3",
    "micromark-extension-gfm-table": "2.1.2",
    "prettier": "3.9.9",
    "remark-lint-list-item-spacing": "5.0.1",
    "remark-parse": "11.0.0",
    "semver": "7.8.5",
    "shell-quote": "1.12.0",
    "smol-toml": "1.9.0",
    "unified": "11.0.5",
    "vfile": "6.0.3",
    "yaml": "2.9.1"
  },
  "license": "MIT",
  "engines": {
    "node": "26.x"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.2.0",
      "onFail": "error"
    }
  },
  "overrides": {
    "micromark": "$micromark",
    "micromark-extension-gfm-table": "$micromark-extension-gfm-table"
  }
}
