{
  "rules": {
    "write-good": {
      "illusion": true,
      "passive": false,
      "weasel": false,
      "adverb": false,
      "eprime": false,
      "so": false,
      "thereIs": false,
      "tooWordy": false,
      "cliches": false
    },
    "terminology": {
      "defaultTerms": true,
      "skip": [],
      "terms": [
        "OpenSpec",
        "ETHOS",
        "GitLab",
        "GitHub",
        "SemVer",
        "CSpell",
        "Prettier",
        "textlint",
        "lychee"
      ],
      "exclude": ["blank line(s)?"]
    },
    "stop-words": {
      "skip": [],
      "exclude": ["authority to", "subject to", "feasible"]
    }
  }
}
