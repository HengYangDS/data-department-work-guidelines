#!/usr/bin/env sh
# ETHOS closes direct accepted-root ref movement. Non-protected ref updates are
# still evaluated by ETHOS and only explicit blocks are refused by the command.
set -eu

phase="${1:-}"
case "$phase" in
  prepared|committed) ;;
  *) exit 0 ;;
esac

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
command -v ethos >/dev/null || {
  echo "ETHOS command is required for reference admission." >&2
  exit 127
}

while read -r old_value new_value ref_name; do
  case "$ref_name" in
    refs/heads/*) ;;
    *) continue ;;
  esac
  bash "$repo_root/scripts/ethos-repo.sh" hook ref-transaction "$ref_name" "$old_value" "$new_value" \
    --phase "$phase" \
    --json >/dev/null
done
