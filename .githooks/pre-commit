#!/usr/bin/env bash
# Portable ETHOS work-lane admission. It intentionally delegates to the active
# `ethos` command instead of importing paths from the ETHOS product repository.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
command -v ethos >/dev/null || {
  echo "ETHOS command is required for tracked commits in this repository." >&2
  exit 127
}

staged=()
while IFS= read -r path; do
  staged+=("$path")
done < <(git diff --cached --name-only --diff-filter=ACMRD)

[[ ${#staged[@]} -eq 0 ]] && exit 0
"$repo_root/scripts/ethos-repo.sh" hook admit pre-tool "${staged[@]}" \
  --editor-root "$repo_root" \
  --require-editor-root \
  --json

# This is only a repository-specific structural check.  OpenSpec lifecycle and
# Change admission remain governed by the repository-bound ETHOS command above.
bash "$repo_root/scripts/validate-governance-boundary.sh"
